# Every variable below is read by src/config.py (or by the Claude Agent SDK
# directly). That file is the authoritative list.

# ---------------------------------------------------------------------------
# Claude Agent SDK
# ---------------------------------------------------------------------------
# Anthropic's terms do not allow a deployed third-party product to ride on a
# claude.ai / Claude Code account login or subscription credits, so a real API
# key from platform.claude.com is required. The SDK reads this variable
# automatically; no other configuration is needed.
ANTHROPIC_API_KEY=your_anthropic_api_key

# The model every turn runs on, manager and subagents alike. Optional.
CLAUDE_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Twilio (WhatsApp channel)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
FROM_WHATSAPP_NUMBER=whatsapp:+your_twilio_number

# ---------------------------------------------------------------------------
# Google OAuth (per user, web application client type)
# ---------------------------------------------------------------------------
# The server uses a web callback flow, not a local browser flow, and builds the
# client config from these two values rather than a committed credentials.json.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Where refresh tokens are stored. On a host with an ephemeral filesystem,
# point this at a mounted volume (e.g. /data/token.json) so a redeploy does
# not lose the grant.
GOOGLE_TOKEN_FILE=token.json

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any Postgres instance. Tables and the read-only reader role are created on
# first boot. Without this the app still starts, but data-backed tools error.
DATABASE_URL=postgresql://user:password@host:port/dbname

# ---------------------------------------------------------------------------
# OpenAI (optional)
# ---------------------------------------------------------------------------
# Used only for voice transcription and document embeddings. Without a key,
# documents are still stored and searched, by keyword instead of semantically.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Phone numbers (E.164, comma separated) allowed to use the assistant at all.
# Empty means anyone who messages the number gets an agent turn.
ALLOWED_PHONES=

# Phone numbers allowed to query the shared business tables. Those tables are
# not keyed by user, so without this gate anyone texting the number could read
# them. Empty means nobody.
BUSINESS_DATA_PHONES=

# Shared secret for POST /webhook/test. That endpoint runs the agent as any
# phone number it is given and returns the reply, so leaving it open would let
# anyone read any user's data. Unset disables the endpoint entirely.
TEST_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000

# This app's own public HTTPS base URL once deployed, no trailing slash, e.g.
# https://your-app.example.com. Used to build a fixed Google OAuth redirect_uri
# rather than guessing it from request headers, which is unreliable behind a
# reverse proxy.
PUBLIC_BASE_URL=
